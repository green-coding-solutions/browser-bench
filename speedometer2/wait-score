#!/bin/sh
# Answers the run phase of the Speedometer 2.1 scenarios.
#
# socat starts this for every connection to port 9000, and whatever it prints
# goes back over that connection. The run phase connects and waits, so it ends
# when this ends.
#
# It waits until the page reports that Speedometer has finished: browser-bench.js
# requests /bench/done, and the server's access log shows that request. Then it
# prints the score as the GMT custom metric speedometer_score, timestamped in
# microseconds. Speedometer shows the score with one decimal and GMT takes
# integers, so the value is the score times 100. Without a score in time it
# prints why, and the run phase fails because the metric line is missing.
limit=${1:-600}
log=/var/log/speedometer-access.log
end=$(( $(date +%s) + limit ))
while :; do
    line=$(grep -m1 '"GET /bench/done?' "$log" 2>/dev/null)
    if [ -n "$line" ]; then
        score=$(echo "$line" | sed -n 's|.*"GET /bench/done?score=\([^ &]*\).*|\1|p')
        case "$score" in
            ''|*[!0-9.]*) echo "Speedometer reported no valid score: $score"; exit 1 ;;
        esac
        echo "Speedometer finished with $score"
        echo "$(date +%s%6N) speedometer_score=$(awk -v s="$score" 'BEGIN { printf "%d", s * 100 + 0.5 }')"
        exit 0
    fi
    if [ "$(date +%s)" -ge "$end" ]; then
        echo "Speedometer did not finish within $limit s"
        exit 1
    fi
    sleep 0.2
done
